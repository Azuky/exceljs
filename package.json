{
  "name": "exceljs",
  "version": "4.4.0",
  "private": false,
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "keywords": [
    "alignment",
    "border",
    "csv",
    "data validations",
    "defined names",
    "excel",
    "fill",
    "font",
    "format",
    "frozen",
    "in-cell format",
    "json",
    "number",
    "number format",
    "office",
    "outlineLevel",
    "pageSetup",
    "rich text",
    "split",
    "spreadsheet",
    "views",
    "workbook",
    "xlsx"
  ],
  "license": "MIT",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exceljs/exceljs.git"
  },
  "files": [
    "dist",
    "index.d.ts",
    "LICENSE",
    "README.md",
    "README_zh.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "pnpm run build && pnpm run test:unit && pnpm run test:integration && pnpm run test:end-to-end && pnpm run test:smoke",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:end-to-end": "vitest run --project end-to-end",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:manual": "node spec/manual/app.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "benchmark": "node --expose-gc benchmark",
    "benchmark:debug": "node --expose-gc --inspect-brk --trace-deopt benchmark",
    "build": "pnpm run clean && tsdown",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -p tsconfig.json",
    "prepare": "husky",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "archiver": "^5.0.0",
    "dayjs": "^1.8.34",
    "fast-csv": "^4.3.1",
    "jszip": "^3.10.1",
    "readable-stream": "^3.6.0",
    "saxes": "^5.0.1",
    "tmp": "^0.2.0",
    "unzipper": "^0.10.11",
    "uuid": "^8.3.0"
  },
  "devDependencies": {
    "@types/chai": "^4.2.12",
    "@types/node": "^22.0.0",
    "chai": "^4.2.0",
    "chai-datetime": "^1.7.0",
    "chai-xml": "^0.3.2",
    "dirty-chai": "^2.0.1",
    "express": "^4.16.4",
    "got": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "sax": "^1.2.4",
    "tsdown": "^0.23.2",
    "typescript": "~7.0.2",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0"
}
